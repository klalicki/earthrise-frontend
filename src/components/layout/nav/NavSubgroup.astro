---
import { Icon } from "astro-icon/components";
import NavItem from "./NavItem.astro";
const { itemData, uid } = Astro.props;

interface Props {
  itemData: any;
  uid: number;
}
---

<div class="nav-dropdown-group">
  <div class="nav-dropdown-trigger">
    <NavItem {...itemData} />
    <button
      class="nav-dropdown-toggle"
      aria-controls={`dropdown-${uid}`}
      aria-expanded="false"
      ><div class="nav-caret"><Icon name="fa7-solid:angle-down" /></div>
    </button>
  </div>

  <div class="nav-dropdown-content hidden" id={`dropdown-${uid}`}>
    {itemData.subItems.map((item: any) => <NavItem {...item} />)}
  </div>
</div>

<style>
  .nav-dropdown-group,
  .nav-dropdown-content,
  .nav-dropdown-trigger {
    display: contents;
  }

  .nav-dropdown-content > :global(*) {
    /* padding-left: 0; */
    /* border: 1px solid red; */
    /* padding: 0.25rem 1rem; */
    font-family: "Montserrat", sans-serif;
    letter-spacing: 0;
  }

  .nav-caret {
    display: none;
  }
  @media (min-width: 900px) {
    .nav-dropdown-content {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      text-align: left;
      margin-top: -1rem;
    }

    .nav-dropdown-content > :global(*) {
      /* border: 1px solid red; */
      padding: 0.5rem 1rem;
      font-family: "Montserrat", sans-serif;
      letter-spacing: 0;
    }
    .nav-caret {
      display: flex;
    }
    .nav-dropdown-toggle {
      color: var(--color-text);
      background-color: var(--color-background);
      display: flex;
      padding: 0.5rem;
    }
    .nav-dropdown-toggle:hover,
    .nav-dropdown-toggle:focus-visible {
      color: var(--color-background);
      background-color: var(--color-theme-accent-b);
    }
    .nav-dropdown-group {
      position: relative;
      display: block;
    }
    .nav-dropdown-trigger {
      display: flex;
    }
    .nav-dropdown-content {
      position: absolute;
      top: calc(100% + 1rem);
      display: flex;
      align-items: stretch;
      flex-direction: column;
      background-color: var(--color-background);
      padding: 0rem;
      z-index: 100;
    }

    .nav-dropdown-content.hidden {
      display: none;
    }
  }
</style>

<script>
  const dropdownState = {
    initialized: false,
    handlers: new WeakMap(),
  };

  // Attach hover, click, and focus handlers to each dropdown group.
  const attachDropdownInteractions = () => {
    document.querySelectorAll(".nav-dropdown-group").forEach((group) => {
      const contentElem = group.querySelector(".nav-dropdown-content");
      const triggerButton = group.querySelector(".nav-dropdown-toggle");

      if (!contentElem || !triggerButton) {
        return;
      }

      const handlers = {
        // Tracks any pending close timer so it can be canceled before the dropdown closes.
        closeTimeout: undefined as ReturnType<typeof setTimeout> | undefined,
        // Toggle the dropdown content open or closed when the trigger button is clicked.
        click: () => {
          contentElem.classList.toggle("hidden");
          triggerButton.ariaExpanded = contentElem.classList.contains("hidden")
            ? "false"
            : "true";
        },
        // Open the dropdown and cancel any pending close timer when the pointer enters.
        mouseenter: () => {
          if (handlers.closeTimeout) {
            clearTimeout(handlers.closeTimeout);
            handlers.closeTimeout = undefined;
          }
          contentElem.classList.toggle("hidden", false);
          triggerButton.ariaExpanded = "true";
        },
        // Start a delayed close when the pointer leaves the dropdown group.
        mouseleave: () => {
          if (handlers.closeTimeout) {
            clearTimeout(handlers.closeTimeout);
          }

          handlers.closeTimeout = setTimeout(() => {
            triggerButton.ariaExpanded = "false";
            contentElem.classList.toggle("hidden", true);
            handlers.closeTimeout = undefined;
          }, 500);
        },
        // Close the dropdown after focus leaves the group, unless focus moves to a child element.
        focusout: (event: Event) => {
          const relatedTarget = (event as FocusEvent)
            .relatedTarget as Node | null;
          const isChildElem = group.contains(relatedTarget);
          if (!isChildElem) {
            if (handlers.closeTimeout) {
              clearTimeout(handlers.closeTimeout);
            }

            handlers.closeTimeout = setTimeout(() => {
              triggerButton.ariaExpanded = "false";
              contentElem.classList.toggle("hidden", true);
              handlers.closeTimeout = undefined;
            }, 500);
          }
        },
      };

      triggerButton.addEventListener("click", handlers.click);
      group.addEventListener("mouseenter", handlers.mouseenter);
      group.addEventListener("mouseleave", handlers.mouseleave);
      group.addEventListener("focusout", handlers.focusout);

      dropdownState.handlers.set(group, handlers);
    });
  };

  // Remove the previously attached handlers before the DOM is swapped out.
  const detachDropdownInteractions = () => {
    document.querySelectorAll(".nav-dropdown-group").forEach((group) => {
      const handlers = dropdownState.handlers.get(group);
      const contentElem = group.querySelector(".nav-dropdown-content");
      const triggerButton = group.querySelector(".nav-dropdown-toggle");

      if (!handlers || !contentElem || !triggerButton) {
        return;
      }

      triggerButton.removeEventListener("click", handlers.click);
      group.removeEventListener("mouseenter", handlers.mouseenter);
      group.removeEventListener("mouseleave", handlers.mouseleave);
      group.removeEventListener("focusout", handlers.focusout);
      contentElem.classList.toggle("hidden", true);
      triggerButton.ariaExpanded = "false";
      dropdownState.handlers.delete(group);
    });
  };

  // Register lifecycle hooks so the listeners are recreated after view transitions.
  const registerViewTransitionHandlers = () => {
    if (dropdownState.initialized) {
      return;
    }

    document.addEventListener("astro:before-swap", detachDropdownInteractions);
    document.addEventListener("astro:after-swap", attachDropdownInteractions);
    dropdownState.initialized = true;
  };

  registerViewTransitionHandlers();
  attachDropdownInteractions();
</script>
